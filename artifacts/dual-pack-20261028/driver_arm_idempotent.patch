+# ---- 方向修正（相机可能被倒装）----
+#   none = 原样；h = 左右翻；v = 上下翻；180 = 上下左右都翻（相机旋转 180° 安装时用这个）
+def apply_flip(gray, w, h, mode):
+    if mode in (None, "", "none"):
+        return gray
+    rows = [gray[y * w:(y + 1) * w] for y in range(h)]
+    if mode in ("h", "180"):
+        rows = [r[::-1] for r in rows]
+    if mode in ("v", "180"):
+        rows = rows[::-1]
+    return b"".join(rows)
+
