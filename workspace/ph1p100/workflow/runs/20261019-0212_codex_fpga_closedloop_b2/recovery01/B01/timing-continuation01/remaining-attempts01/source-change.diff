+// Two-slot, same-clock token queue. Markers wait for actual input acceptance;
+// unlike an output notification FIFO they never pop automatically on abort.
+module algo_branch_elastic2(
+    input wire clk,rst_n,input wire w_valid,output wire w_ready,
+    input wire [35:0] w_token,output wire r_valid,input wire r_ready,
+    output wire [35:0] r_token
+);
+    reg [35:0] slot0,slot1;
+    reg wr,rd,room;
+    reg [1:0] count;
+    wire push=w_valid&&w_ready;
+    wire pop=r_valid&&r_ready;
+    assign w_ready=room;
+    assign r_valid=(count!=0);
+    assign r_token=r_valid ? (rd?slot1:slot0) : 36'd0;
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin wr<=0;rd<=0;count<=0;room<=1;end
+        else begin
+            if(push) begin if(wr)slot1<=w_token;else slot0<=w_token;wr<=!wr;end
+            if(pop)rd<=!rd;
+            case({push,pop})
+                2'b10:begin count<=count+1'b1;room<=(count==0);end
+                2'b01:begin count<=count-1'b1;room<=1;end
+                default:begin count<=count;room<=room;end
+            endcase
+        end
+    end
+endmodule
