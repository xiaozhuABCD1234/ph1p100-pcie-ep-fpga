diff --git a/rtl/ep_side/ddr/ddr_readback_int.v b/rtl/ep_side/ddr/ddr_readback_int.v
new file mode 100644
index 0000000..aff7f9f
--- /dev/null
+++ b/rtl/ep_side/ddr/ddr_readback_int.v
@@ -0,0 +1,272 @@
+///////////////////////////////////////////////////////////////////////////////
+//  ddr_readback_int.v — T11.runC N1：DDR 读回校验集成（debug 通道专用）
+//
+//  仅由 ph1p_pcie_ep_top 在 DBG_CTRL_DEFAULT_EN=1（debug 顶层）时例化；
+//  生产 00_all（默认 0）不例化本模块，DBG-off 路径与 r3 等价。
+//
+//  组成（tl 域触发/回读 + dhi 域 checker + 读口仲裁）：
+//   1) 发布触发：tl 域检测 DDR_SEQ_A(seq_in) 变化 → 锁存 BASE/LEN → toggle 两级
+//      同步到 dhi 域 → 稳定后采 base/len，再出单拍 start；busy 重入由 checker
+//      契约拒绝（不重启、不清进度，该次触发丢弃）。
+//   2) ddr_frame_readback_checker 实例（AXI4 读主 256bit/INCR，时钟 dhi_clk）。
+//   3) 结果两级同步回 tl 域（o_status/o_words/o_hdr_crc/o_pay_crc/o_runs/
+//      o_smp1/o_smp2），供 ep_bar_win 调试字库 word9..word15 只读镜像。
+//   4) 读口仲裁：m0=推帧引擎（原唯一读者）、m1=checker。互斥占用，每笔突发到
+//      R 通道末拍(rlast)才换手；双请求时 round-robin（初值先给 m0），单请求直通。
+//      不改变任何写口/推帧/MWr 语义；checker 低优先（不抢占），不会被饿死。
+//  复位：rst_tl=power_on_rst_dly（tl 域）、rst_dhi=~ddrphy_rst_n（dhi 域），均不
+//  依赖 PCIe 链路。
+///////////////////////////////////////////////////////////////////////////////
+`timescale 1ns/1ps
+
+module ddr_readback_int (
+    // ---- tl_clk_user 域（发布字来自 cam_r10f_writer A 路；调试字输出）----
+    input  wire         clk_tl,
+    input  wire         rst_tl,
+    input  wire [31:0]  seq_in,
+    input  wire [31:0]  base_in,
+    input  wire [31:0]  len_in,
+    output wire [31:0]  o_status,
+    output wire [31:0]  o_words,
+    output wire [31:0]  o_hdr_crc,
+    output wire [31:0]  o_pay_crc,
+    output wire [31:0]  o_runs,
+    output wire [31:0]  o_smp1,
+    output wire [31:0]  o_smp2,
+
+    // ---- dhi_clk 域 ----
+    input  wire         clk_dhi,
+    input  wire         rst_dhi,
+
+    // ---- AXI4 读 m0：推帧引擎（原读者，行为不变）----
+    input  wire [3:0]   m0_arid,
+    input  wire [28:0]  m0_araddr,
+    input  wire [7:0]   m0_arlen,
+    input  wire [2:0]   m0_arsize,
+    input  wire [1:0]   m0_arburst,
+    input  wire         m0_arvalid,
+    output wire         m0_arready,
+    output wire [3:0]   m0_rid,
+    output wire [255:0] m0_rdata,
+    output wire [1:0]   m0_rresp,
+    output wire         m0_rlast,
+    output wire         m0_rvalid,
+    input  wire         m0_rready,
+
+    // ---- AXI4 读 slave：DDR MC 用户侧读口 ----
+    output wire [3:0]   s_arid,
+    output wire [28:0]  s_araddr,
+    output wire [7:0]   s_arlen,
+    output wire [2:0]   s_arsize,
+    output wire [1:0]   s_arburst,
+    output wire         s_arvalid,
+    input  wire         s_arready,
+    input  wire [3:0]   s_rid,
+    input  wire [255:0] s_rdata,
+    input  wire [1:0]   s_rresp,
+    input  wire         s_rlast,
+    input  wire         s_rvalid,
+    output wire         s_rready
+);
+
+    // ========================================================================
+    //  1) tl 域：发布触发锁存（seq 变化 = 新帧发布）
+    // ========================================================================
+    reg  [31:0] seq_q, base_q, len_q;
+    reg         req_tgl;
+
+    always @(posedge clk_tl or posedge rst_tl) begin
+        if (rst_tl) begin
+            seq_q   <= 32'd0;
+            base_q  <= 32'd0;
+            len_q   <= 32'd0;
+            req_tgl <= 1'b0;
+        end else if (seq_in != seq_q) begin
+            seq_q   <= seq_in;
+            base_q  <= base_in;
+            len_q   <= len_in;
+            req_tgl <= ~req_tgl;
+        end
+    end
+
+    // ========================================================================
+    //  dhi 域：toggle 两级同步 + 边沿；base/len 稳定后采样，再出单拍 start
+    // ========================================================================
+    reg  [1:0]  tgl_sync;
+    wire        tgl_edge = tgl_sync[1] ^ tgl_sync[0];
+    reg  [31:0] base_hold, len_hold;
+    reg         chk_start;
+
+    always @(posedge clk_dhi or posedge rst_dhi) begin
+        if (rst_dhi) begin
+            tgl_sync  <= 2'b00;
+            base_hold <= 32'd0;
+            len_hold  <= 32'd0;
+            chk_start <= 1'b0;
+        end else begin
+            tgl_sync  <= {tgl_sync[0], req_tgl};
+            if (tgl_edge) begin
+                base_hold <= base_q;
+                len_hold  <= len_q;
+            end
+            chk_start <= tgl_edge;
+        end
+    end
+
+    // ========================================================================
+    //  2) checker 实例
+    // ========================================================================
+    wire         chk_busy, chk_done, chk_magic_ok, chk_hdr_ok, chk_pay_ok, chk_len_ok;
+    wire [7:0]   chk_err;
+    wire [31:0]  chk_words, chk_hdrcrc, chk_paycrc, chk_smp1, chk_smp2;
+    wire [3:0]   c1_arid;
+    wire [28:0]  c1_araddr;
+    wire [7:0]   c1_arlen;
+    wire [2:0]   c1_arsize;
+    wire [1:0]   c1_arburst;
+    wire         c1_arvalid, c1_arready;
+    wire [3:0]   c1_rid;
+    wire [255:0] c1_rdata;
+    wire [1:0]   c1_rresp;
+    wire         c1_rlast, c1_rvalid, c1_rready;
+
+    ddr_frame_readback_checker u_chk (
+        .clk_dhi         (clk_dhi),
+        .rst_dhi         (rst_dhi),
+        .start           (chk_start),
+        .base            ({35'd0, base_hold[28:0]}),
+        .frame_bytes     (len_hold),
+        .abort           (1'b0),
+        .busy            (chk_busy),
+        .done            (chk_done),
+        .magic_ok        (chk_magic_ok),
+        .hdr_crc_ok      (chk_hdr_ok),
+        .payload_crc_ok  (chk_pay_ok),
+        .length_ok       (chk_len_ok),
+        .err_code        (chk_err),
+        .rd_header_crc32 (chk_hdrcrc),
+        .rd_payload_crc32(chk_paycrc),
+        .words_read      (chk_words),
+        .smp0            (),
+        .smp1            (chk_smp1),
+        .smp2            (chk_smp2),
+        .smp3            (),
+        .smp4            (),
+        .smp5            (),
+        .m_axi_arid      (c1_arid),
+        .m_axi_araddr    (c1_araddr),
+        .m_axi_arlen     (c1_arlen),
+        .m_axi_arsize    (c1_arsize),
+        .m_axi_arburst   (c1_arburst),
+        .m_axi_arvalid   (c1_arvalid),
+        .m_axi_arready   (c1_arready),
+        .m_axi_rid       (c1_rid),
+        .m_axi_rdata     (c1_rdata),
+        .m_axi_rresp     (c1_rresp),
+        .m_axi_rlast     (c1_rlast),
+        .m_axi_rvalid    (c1_rvalid),
+        .m_axi_rready    (c1_rready)
+    );
+
+    // 完成计数（dhi 域 done 上升沿；每次完成校验 +1）
+    reg  [31:0] runs_cnt;
+    reg         done_q;
+    always @(posedge clk_dhi or posedge rst_dhi) begin
+        if (rst_dhi) begin
+            runs_cnt <= 32'd0;
+            done_q   <= 1'b0;
+        end else begin
+            done_q <= chk_done;
+            if (chk_done & ~done_q) runs_cnt <= runs_cnt + 32'd1;
+        end
+    end
+
+    // ========================================================================
+    //  3) 结果两级同步回 tl 域（调试字）
+    //   word9  = {16'd0, err[7:0], 2'b00, length_ok, payload_crc_ok,
+    //             hdr_crc_ok, magic_ok, done, busy}
+    // ========================================================================
+    wire [31:0] status_w = {16'd0, chk_err, 2'b00, chk_len_ok, chk_pay_ok,
+                            chk_hdr_ok, chk_magic_ok, chk_done, chk_busy};
+
+    reg  [31:0] s1_status, s2_status, s1_words, s2_words;
+    reg  [31:0] s1_hdrcrc, s2_hdrcrc, s1_paycrc, s2_paycrc;
+    reg  [31:0] s1_runs, s2_runs, s1_smp1, s2_smp1, s1_smp2, s2_smp2;
+
+    always @(posedge clk_tl) begin
+        s1_status <= status_w;    s2_status <= s1_status;
+        s1_words  <= chk_words;   s2_words  <= s1_words;
+        s1_hdrcrc <= chk_hdrcrc;  s2_hdrcrc <= s1_hdrcrc;
+        s1_paycrc <= chk_paycrc;  s2_paycrc <= s1_paycrc;
+        s1_runs   <= runs_cnt;    s2_runs   <= s1_runs;
+        s1_smp1   <= chk_smp1;    s2_smp1   <= s1_smp1;
+        s1_smp2   <= chk_smp2;    s2_smp2   <= s1_smp2;
+    end
+
+    assign o_status  = s2_status;
+    assign o_words   = s2_words;
+    assign o_hdr_crc = s2_hdrcrc;
+    assign o_pay_crc = s2_paycrc;
+    assign o_runs    = s2_runs;
+    assign o_smp1    = s2_smp1;
+    assign o_smp2    = s2_smp2;
+
+    // ========================================================================
+    //  4) 读口仲裁（dhi 域）：m0=pusher / m1=checker
+    //     互斥占用（AR 接受起 → R 末拍 rlast 止），双请求 round-robin
+    // ========================================================================
+    reg         rd_busy;    // 有未完成读事务
+    reg         rd_cur;     // 当前占用者：0=m0，1=m1（rd_busy=1 时有效）
+    reg         last_m1;    // 上一次授权者（1=m1）→ round-robin 记忆；初值 1：双请求先给 m0
+
+    wire        arb_idle  = ~rd_busy;
+    wire        both_req  = m0_arvalid & c1_arvalid;
+    wire        pick_m1   = arb_idle & (both_req ? ~last_m1 : c1_arvalid);
+    wire        pick_m0   = arb_idle & m0_arvalid & ~pick_m1;
+
+    wire        s_arvalid_w = rd_busy ? (rd_cur ? c1_arvalid : m0_arvalid)
+                                      : (pick_m1 ? c1_arvalid : (pick_m0 ? m0_arvalid : 1'b0));
+    wire        ar_hs   = s_arvalid_w & s_arready;
+    wire        s_rready_w = rd_cur ? c1_rready : m0_rready;
+    wire        r_fin   = rd_busy & s_rvalid & s_rlast & s_rready_w;
+
+    always @(posedge clk_dhi or posedge rst_dhi) begin
+        if (rst_dhi) begin
+            rd_busy <= 1'b0;
+            rd_cur  <= 1'b0;
+            last_m1 <= 1'b1;
+        end else if (arb_idle && ar_hs) begin
+            rd_busy <= 1'b1;
+            rd_cur  <= pick_m1;
+            last_m1 <= pick_m1;
+        end else if (r_fin) begin
+            rd_busy <= 1'b0;
+        end
+    end
+
+    wire        sel_m1 = rd_busy ? rd_cur : pick_m1;   // AR 拍必须按“本拍授权”选，不能看 rd_cur
+    assign s_arid    = sel_m1 ? c1_arid    : m0_arid;
+    assign s_araddr  = sel_m1 ? c1_araddr  : m0_araddr;
+    assign s_arlen   = sel_m1 ? c1_arlen   : m0_arlen;
+    assign s_arsize  = sel_m1 ? c1_arsize  : m0_arsize;
+    assign s_arburst = sel_m1 ? c1_arburst : m0_arburst;
+    assign s_arvalid = s_arvalid_w;
+
+    assign m0_arready = pick_m0 & s_arready;
+    assign c1_arready = pick_m1 & s_arready;
+
+    assign m0_rid    = s_rid;
+    assign m0_rdata  = s_rdata;
+    assign m0_rresp  = s_rresp;
+    assign m0_rlast  = s_rlast;
+    assign m0_rvalid = rd_busy & ~rd_cur & s_rvalid;
+
+    assign c1_rid    = s_rid;
+    assign c1_rdata  = s_rdata;
+    assign c1_rresp  = s_rresp;
+    assign c1_rlast  = s_rlast;
+    assign c1_rvalid = rd_busy & rd_cur & s_rvalid;
+
+    assign s_rready  = s_rready_w;
+
+endmodule

diff --git a/sim/tb/tb_ddr_readback_int.v b/sim/tb/tb_ddr_readback_int.v
new file mode 100644
index 0000000..f000471
--- /dev/null
+++ b/sim/tb/tb_ddr_readback_int.v
@@ -0,0 +1,547 @@
+///////////////////////////////////////////////////////////////////////////////
+//  tb_ddr_readback_int.v — T11.runC N1 新 TB：DDR 读回校验集成 + 字库
+//
+//  覆盖：
+//   A) 触发/正例：tl 域 SEQ 变化 → 锁存 base/len → checker 读回 → 全 ok 位、
+//      words_read/CRC/runs/smp1/smp2 与预置帧字段逐位一致；
+//   B) 基址变化：新 SEQ + 新 base 生效（第二次校验读新区域）；
+//   C) 负例：载荷 CRC 破坏 → payload_crc_ok=0、err_code=3（不产生假 PASS）；
+//   D) busy 重入：长帧校验期间再来一次发布 → 该次触发被丢弃（不重启不清进度），
+//      本次结果仍属于旧 base；完成后再发布可正常校验；
+//   E) 读仲裁：pusher 桩持续请求时 checker 仍完成（不饿死），两路数据均正确；
+//   F) 字库：ep_bar_win DBG-on 新字 word9..15 逐位=输入、既有字 word0..8 不变；
+//      DBG-off 新字读值恒 DEAD_BEEF（生产读行为不变）。
+//  运行：tools/pcie_integration/run_sim.ps1 -Tb tb_ddr_readback_int \
+//        -OutDir <dir> -TbFiles tb/tb_ddr_readback_int.v -Defines MIPI_PHY_SIM_STUB
+///////////////////////////////////////////////////////////////////////////////
+`timescale 1ns/1ps
+
+module tb_ddr_readback_int;
+
+    integer errors = 0;
+
+    // ---------------- 时钟/复位 ----------------
+    reg clk_dhi = 0;   // 100 MHz
+    reg clk_tl  = 0;   // 62.5 MHz
+    reg rst_dhi = 1;
+    reg rst_tl  = 1;
+    always #5 clk_dhi = ~clk_dhi;
+    always #8 clk_tl  = ~clk_tl;
+
+    task chk32;
+        input [255:0] label;
+        input [31:0]  got;
+        input [31:0]  exp;
+        begin
+            if (got !== exp) begin
+                $display("ERROR: %0s got=%08h exp=%08h", label, got, exp);
+                errors = errors + 1;
+            end else begin
+                $display("ok: %0s = %08h", label, got);
+            end
+        end
+    endtask
+
+    // ---------------- 存储模型（低 16 位字节地址 → 32bit 字）----------------
+    reg [31:0] mem [0:16383];
+    integer    mi;
+
+    function [31:0] crc32_byte;
+        input [31:0] c;
+        input [7:0]  b;
+        integer k;
+        reg [31:0] x;
+        begin
+            x = c ^ {24'd0, b};
+            for (k = 0; k < 8; k = k + 1)
+                x = x[0] ? ((x >> 1) ^ 32'hEDB88320) : (x >> 1);
+            crc32_byte = x;
+        end
+    endfunction
+
+    function [31:0] crc32_word;   // 小端字节序 b0,b1,b2,b3
+        input [31:0] c;
+        input [31:0] w;
+        begin
+            crc32_word = crc32_byte(crc32_byte(crc32_byte(crc32_byte(
+                         c, w[7:0]), w[15:8]), w[23:16]), w[31:24]);
+        end
+    endfunction
+
+    function [31:0] mex;
+        input [31:0] base;
+        input integer idx;
+        begin
+            mex = mem[((base >> 2) + idx) & 16'h3FFF];
+        end
+    endfunction
+
+    task setw;
+        input [31:0] base;
+        input integer idx;
+        input [31:0] v;
+        begin
+            mem[((base >> 2) + idx) & 16'h3FFF] = v;
+        end
+    endtask
+
+    // 构造 R10F v1 帧（头 128B + packed 载荷 P 字节 + 4KiB 对齐尾零）
+    task build_frame;
+        input [31:0] base;
+        input integer P;
+        input integer bad_magic;
+        input integer corrupt_pay;
+        integer i, fb, nw;
+        reg [31:0] c;
+        begin
+            fb = ((128 + P + 4095) / 4096) * 4096;
+            nw = fb / 4;
+            for (i = 0; i < nw; i = i + 1) setw(base, i, 32'd0);
+            setw(base, 0,  bad_magic ? 32'hDEAD_0001 : 32'h4630_3152); // "R10F"
+            setw(base, 12, P);
+            for (i = 32; i < 32 + P/4; i = i + 1)
+                setw(base, i, 32'hA5A5_0000 + i);
+            c = 32'hFFFF_FFFF;
+            for (i = 32; i < 32 + P/4; i = i + 1)
+                c = crc32_word(c, mem[((base >> 2) + i) & 16'h3FFF]);
+            setw(base, 21, ~c);             // payload_crc32 字段
+            setw(base, 20, 32'h5A5A_1234);  // raw_crc32（不参与判定；smp1 对照）
+            c = 32'hFFFF_FFFF;
+            for (i = 0; i < 32; i = i + 1)
+                c = crc32_word(c, (i == 22) ? 32'd0 : mem[((base >> 2) + i) & 16'h3FFF]);
+            setw(base, 22, ~c);             // header_crc32 字段
+            if (corrupt_pay)
+                setw(base, 32, mem[((base >> 2) + 32) & 16'h3FFF] ^ 32'h0000_00FF);
+        end
+    endtask
+
+    // ---------------- DUT（触发 CDC + checker + 读仲裁）----------------
+    reg  [31:0] seq_d = 0, base_d = 0, len_d = 0;
+    wire [31:0] o_status, o_words, o_hdr, o_pay, o_runs, o_smp1, o_smp2;
+
+    reg  [28:0] m0_araddr;
+    reg         m0_arvalid;
+    wire [3:0]  m0_arid;
+    wire [7:0]  m0_arlen;
+    wire [2:0]  m0_arsize;
+    wire [1:0]  m0_arburst;
+    wire        m0_arready;
+    wire [3:0]  m0_rid;
+    wire [255:0] m0_rdata;
+    wire [1:0]  m0_rresp;
+    wire        m0_rlast, m0_rvalid;
+    wire        m0_rready;
+
+    wire [3:0]  s_arid;
+    wire [28:0] s_araddr;
+    wire [7:0]  s_arlen;
+    wire [2:0]  s_arsize;
+    wire [1:0]  s_arburst;
+    wire        s_arvalid;
+    reg         s_arready;
+    reg  [3:0]  s_rid;
+    reg  [255:0] s_rdata;
+    reg  [1:0]  s_rresp;
+    reg         s_rlast, s_rvalid;
+    wire        s_rready;
+
+    ddr_readback_int u_dut (
+        .clk_tl    (clk_tl),
+        .rst_tl    (rst_tl),
+        .seq_in    (seq_d),
+        .base_in   (base_d),
+        .len_in    (len_d),
+        .o_status  (o_status),
+        .o_words   (o_words),
+        .o_hdr_crc (o_hdr),
+        .o_pay_crc (o_pay),
+        .o_runs    (o_runs),
+        .o_smp1    (o_smp1),
+        .o_smp2    (o_smp2),
+        .clk_dhi   (clk_dhi),
+        .rst_dhi   (rst_dhi),
+        .m0_arid   (m0_arid),
+        .m0_araddr (m0_araddr),
+        .m0_arlen  (m0_arlen),
+        .m0_arsize (m0_arsize),
+        .m0_arburst(m0_arburst),
+        .m0_arvalid(m0_arvalid),
+        .m0_arready(m0_arready),
+        .m0_rid    (m0_rid),
+        .m0_rdata  (m0_rdata),
+        .m0_rresp  (m0_rresp),
+        .m0_rlast  (m0_rlast),
+        .m0_rvalid (m0_rvalid),
+        .m0_rready (m0_rready),
+        .s_arid    (s_arid),
+        .s_araddr  (s_araddr),
+        .s_arlen   (s_arlen),
+        .s_arsize  (s_arsize),
+        .s_arburst (s_arburst),
+        .s_arvalid (s_arvalid),
+        .s_arready (s_arready),
+        .s_rid     (s_rid),
+        .s_rdata   (s_rdata),
+        .s_rresp   (s_rresp),
+        .s_rlast   (s_rlast),
+        .s_rvalid  (s_rvalid),
+        .s_rready  (s_rready)
+    );
+
+    // ---------------- AXI slave（DDR 桩：顺序出数，1 拍/beat）----------------
+    reg        sl_busy;
+    reg [28:0] sl_addr;
+    reg [8:0]  sl_cnt, sl_beats;
+    wire [31:0] bi0 = (sl_addr[15:2] + sl_cnt*8) & 16'h3FFF;
+
+    always @(posedge clk_dhi or posedge rst_dhi) begin
+        if (rst_dhi) begin
+            s_arready <= 1'b1;
+            s_rvalid  <= 1'b0;
+            s_rlast   <= 1'b0;
+            s_rdata   <= 256'd0;
+            s_rresp   <= 2'b00;
+            sl_busy   <= 1'b0;
+            sl_addr   <= 29'd0;
+            sl_cnt    <= 9'd0;
+            sl_beats  <= 9'd0;
+        end else begin
+            if (!sl_busy) begin
+                if (s_arready && s_arvalid) begin
+                    sl_addr   <= s_araddr;
+                    sl_beats  <= {1'b0, s_arlen} + 9'd1;
+                    sl_cnt    <= 9'd0;
+                    sl_busy   <= 1'b1;
+                    s_arready <= 1'b0;
+                end
+            end else begin
+                s_rvalid <= 1'b1;
+                s_rdata  <= {mem[(bi0+7)&16'h3FFF], mem[(bi0+6)&16'h3FFF],
+                             mem[(bi0+5)&16'h3FFF], mem[(bi0+4)&16'h3FFF],
+                             mem[(bi0+3)&16'h3FFF], mem[(bi0+2)&16'h3FFF],
+                             mem[(bi0+1)&16'h3FFF], mem[bi0]};
+                s_rlast  <= (sl_cnt == sl_beats - 9'd1);
+                if (s_rvalid && s_rready) begin
+                    sl_cnt <= sl_cnt + 9'd1;
+                    if (sl_cnt == sl_beats - 9'd1) begin
+                        sl_busy   <= 1'b0;
+                        s_arready <= 1'b1;
+                        s_rvalid  <= 1'b0;
+                        s_rlast   <= 1'b0;
+                    end
+                end
+            end
+        end
+    end
+
+    // ---------------- pusher 桩（m0）：连续 1-beat 读 + 数据自检 ----------------
+    localparam [28:0] PUSH_BASE = 29'h0020_9000;
+    localparam integer NPUSH = 64;
+
+    reg         push_run = 0;
+    reg  [1:0]  pst;
+    reg  [28:0] pa;
+    reg  [31:0] push_ok, push_bad;
+
+    assign m0_arid    = 4'd0;
+    assign m0_arlen   = 8'd0;
+    assign m0_arsize  = 3'd5;
+    assign m0_arburst = 2'b01;
+    assign m0_rready  = 1'b1;
+
+    always @(posedge clk_dhi or posedge rst_dhi) begin
+        if (rst_dhi) begin
+            pst      <= 2'd0;
+            pa       <= PUSH_BASE;
+            push_ok  <= 32'd0;
+            push_bad <= 32'd0;
+            m0_arvalid <= 1'b0;
+            m0_araddr  <= 29'd0;
+        end else if (push_run) begin
+            case (pst)
+                2'd0: if (pa < PUSH_BASE + NPUSH*32) begin
+                          m0_arvalid <= 1'b1;
+                          m0_araddr  <= pa;
+                          pst        <= 2'd1;
+                      end
+                2'd1: if (m0_arready) begin
+                          m0_arvalid <= 1'b0;
+                          pst        <= 2'd2;
+                      end
+                2'd2: if (m0_rvalid) begin
+                          if (m0_rdata[31:0] !== mem[(pa[15:2]) & 16'h3FFF])
+                              push_bad <= push_bad + 32'd1;
+                          else
+                              push_ok <= push_ok + 32'd1;
+                          pa  <= pa + 32'd32;
+                          pst <= (pa + 32'd32 >= PUSH_BASE + NPUSH*32) ? 2'd3 : 2'd0;
+                      end
+                default: ;
+            endcase
+        end
+    end
+
+    // ---------------- AR 计数（仲裁证据）----------------
+    integer chk_ars = 0;
+    integer push_ars = 0;
+    always @(posedge clk_dhi or posedge rst_dhi) begin
+        if (rst_dhi) begin
+            chk_ars  <= 0;
+            push_ars <= 0;
+        end else begin
+            if (u_dut.u_chk.m_axi_arvalid && u_dut.u_chk.m_axi_arready)
+                chk_ars <= chk_ars + 1;
+            if (m0_arvalid && m0_arready)
+                push_ars <= push_ars + 1;
+        end
+    end
+
+    // ---------------- 辅助任务 ----------------
+    task wait_runs;
+        input integer n;
+        integer guard;
+        begin
+            guard = 0;
+            while ((o_runs != n) && (guard < 3000000)) begin
+                @(posedge clk_tl);
+                guard = guard + 1;
+            end
+            if (guard >= 3000000) begin
+                $display("ERROR: wait_runs(%0d) timeout o_runs=%0d", n, o_runs);
+                errors = errors + 1;
+            end
+            repeat (3) @(posedge clk_tl);
+        end
+    endtask
+
+    task publish;
+        input [31:0] b;
+        input [31:0] l;
+        begin
+            @(negedge clk_tl);
+            base_d <= b;
+            len_d  <= l;
+            seq_d  <= seq_d + 32'd1;
+        end
+    endtask
+
+    task wait_chk_done;
+        integer guard;
+        begin
+            guard = 0;
+            while (!((u_dut.u_chk.done === 1'b1) && (u_dut.u_chk.busy === 1'b0))
+                   && (guard < 2000000)) begin
+                @(posedge clk_dhi);
+                guard = guard + 1;
+            end
+            if (guard >= 2000000) begin
+                $display("ERROR: wait_chk_done timeout");
+                errors = errors + 1;
+            end
+            @(posedge clk_tl); @(posedge clk_tl); @(posedge clk_tl);
+        end
+    endtask
+
+    // ---------------- ep_bar_win 字库实例（F 段）----------------
+    reg  [31:0] chk_a9, chk_a10, chk_a11, chk_a12, chk_a13, chk_a14, chk_a15;
+    reg  [127:0] dbg_ddr_ro;
+    reg  [127:0] dbg_ddr_ro_b;
+    reg  [31:0] dbg_csi_a, dbg_csi_a2;
+    reg         dbg_por_rst = 1'b1;
+
+    ep_bar_win #(
+        .MAGIC(32'h5043_4946), .VERSION(32'h0002_0000),
+        .PTR_BYTES(32'h0004_B000), .CLK_MHZ(9'd62),
+        .MAGIC_RKA1(32'h3141_4B52), .VERSION_RKA1(32'h0001_0000),
+        .DBG_CTRL_DEFAULT_EN(1'b1)
+    ) u_dbg (
+        .clk(clk_tl), .rst(1'b0), .dbg_por_rst(dbg_por_rst),
+        .rx_sop_ff(1'b0), .rx_data_ff(256'd0),
+        .mrdata_rd_data(), .memrd_addr_lo(),
+        .ddr_ro_b(dbg_ddr_ro_b), .cam_diag_b(32'd0),
+        .cam_tap_cfg(), .cam_tap_b_cfg(), .cam_ab_sel(),
+        .cam_drop_a(96'd0),
+        .ctrl_enable(), .ctrl_trigger(), .ctrl_pattern(),
+        .ctrl_ddr_en(), .ddr_ro(dbg_ddr_ro),
+        .push_ro(128'd0), .ctrl_push_en(), .ctrl_push_src(),
+        .push_dst_lo(), .push_dst_hi(), .push_db_lo(), .push_db_hi(),
+        .host_rd_prio(), .host_grant(1'b0),
+        .st_ready(1'b0), .st_busy(1'b0), .st_frame_cnt(32'd0),
+        .st_width(16'd0), .st_height(16'd0), .st_data_len(32'd0),
+        .fb_raddr(), .fb_rdata(32'd0), .dbg_rd_idx(32'd0), .cam_stat(256'd0),
+        .tx_cap_bytes(), .tx_session_id(), .tx_cmd_arm(), .tx_cmd_ack(),
+        .tx_cmd_cancel(), .tx_ack_seq(), .tx_ack_session(),
+        .tx_status_in(32'd0), .tx_block_cfg(1'b0), .cfg_reject(),
+        .csi_diag_a(dbg_csi_a), .csi_diag_a2(dbg_csi_a2),
+        .csi_diag_b(32'd0), .csi_diag_b2(32'd0),
+        .chk_status(chk_a9), .chk_words(chk_a10), .chk_hdr_crc(chk_a11),
+        .chk_pay_crc(chk_a12), .chk_runs(chk_a13), .chk_smp1(chk_a14),
+        .chk_smp2(chk_a15)
+    );
+
+    ep_bar_win #(
+        .MAGIC(32'h5043_4946), .VERSION(32'h0002_0000),
+        .PTR_BYTES(32'h0004_B000), .CLK_MHZ(9'd62),
+        .MAGIC_RKA1(32'h3141_4B52), .VERSION_RKA1(32'h0001_0000),
+        .DBG_CTRL_DEFAULT_EN(1'b0)
+    ) u_prod (
+        .clk(clk_tl), .rst(1'b0), .dbg_por_rst(1'b0),
+        .rx_sop_ff(1'b0), .rx_data_ff(256'd0),
+        .mrdata_rd_data(), .memrd_addr_lo(),
+        .ddr_ro_b(dbg_ddr_ro_b), .cam_diag_b(32'd0),
+        .cam_tap_cfg(), .cam_tap_b_cfg(), .cam_ab_sel(),
+        .cam_drop_a(96'd0),
+        .ctrl_enable(), .ctrl_trigger(), .ctrl_pattern(),
+        .ctrl_ddr_en(), .ddr_ro(dbg_ddr_ro),
+        .push_ro(128'd0), .ctrl_push_en(), .ctrl_push_src(),
+        .push_dst_lo(), .push_dst_hi(), .push_db_lo(), .push_db_hi(),
+        .host_rd_prio(), .host_grant(1'b0),
+        .st_ready(1'b0), .st_busy(1'b0), .st_frame_cnt(32'd0),
+        .st_width(16'd0), .st_height(16'd0), .st_data_len(32'd0),
+        .fb_raddr(), .fb_rdata(32'd0), .dbg_rd_idx(32'd0), .cam_stat(256'd0),
+        .tx_cap_bytes(), .tx_session_id(), .tx_cmd_arm(), .tx_cmd_ack(),
+        .tx_cmd_cancel(), .tx_ack_seq(), .tx_ack_session(),
+        .tx_status_in(32'd0), .tx_block_cfg(1'b0), .cfg_reject(),
+        .csi_diag_a(dbg_csi_a), .csi_diag_a2(dbg_csi_a2),
+        .csi_diag_b(32'd0), .csi_diag_b2(32'd0),
+        .chk_status(chk_a9), .chk_words(chk_a10), .chk_hdr_crc(chk_a11),
+        .chk_pay_crc(chk_a12), .chk_runs(chk_a13), .chk_smp1(chk_a14),
+        .chk_smp2(chk_a15)
+    );
+
+    // ---------------- 主流程 ----------------
+    integer gi;
+    initial begin
+        // 存储清零 + 预置各帧/推帧区
+        for (mi = 0; mi < 16384; mi = mi + 1) mem[mi] = 32'd0;
+        build_frame(32'h0010_0000, 64, 0, 0);      // A
+        build_frame(32'h0010_1000, 64, 0, 0);      // B
+        build_frame(32'h0010_2000, 64, 0, 1);      // C：载荷 CRC 破坏
+        build_frame(32'h0010_3000, 64, 1, 0);      // D-wrong：magic 错（其触发应被丢弃）
+        build_frame(32'h0010_4000, 16000, 0, 0);   // D-long：16384B（长忙）
+        build_frame(32'h0010_A000, 64, 0, 0);      // F（E 段并发校验用）
+        for (gi = 0; gi < NPUSH; gi = gi + 1)
+            mem[((PUSH_BASE >> 2) + gi*8) & 16'h3FFF] = 32'hC0DE_0000 + gi;
+
+        dbg_ddr_ro   = {32'h0027_9000, 32'h0001_0018, 32'h0010_0000, 32'h0000_0007};
+        dbg_ddr_ro_b = {32'h0000_0011, 32'h0000_0022, 32'h0000_0033, 32'h0000_0044};
+        dbg_csi_a    = 32'hA1B2_C3D4;
+        dbg_csi_a2   = 32'h0000_0438;
+
+        #100;
+        rst_dhi = 0;
+        rst_tl  = 0;
+        #200;
+
+        // ---------- A) 正例（小帧） ----------
+        $display("=== A) 首帧自动校验（base=0x00100000, P=64）===");
+        publish(32'h0010_0000, 32'd4096);
+        wait_runs(1);
+        chk32("A word9  status ", o_status, 32'h0000_003E);   // err0; magic/hdr/pay/len ok; done
+        chk32("A word10 words  ", o_words,  32'd1024);
+        chk32("A word11 hdr_crc", o_hdr,    mex(32'h0010_0000,22));
+        chk32("A word12 pay_crc", o_pay,    mex(32'h0010_0000,21));
+        chk32("A word13 runs   ", o_runs,   32'd1);
+        chk32("A word14 smp1   ", o_smp1,   32'h5A5A_1234);
+        chk32("A word15 smp2   ", o_smp2,   mex(32'h0010_0000,21));
+
+        // ---------- B) 基址变化 ----------
+        $display("=== B) base 变化 → 第二次校验读新区域 ===");
+        publish(32'h0010_1000, 32'd4096);
+        wait_runs(2);
+        chk32("B word9  status ", o_status, 32'h0000_003E);
+        chk32("B word11 hdr_crc", o_hdr,    mex(32'h0010_1000,22));
+        chk32("B word12 pay_crc", o_pay,    mex(32'h0010_1000,21));
+        chk32("B word13 runs   ", o_runs,   32'd2);
+
+        // ---------- C) 负例：载荷 CRC 破坏 → err=3 ----------
+        $display("=== C) 载荷 CRC 破坏 → payload_crc_ok=0 / err_code=3 ===");
+        publish(32'h0010_2000, 32'd4096);
+        wait_runs(3);
+        chk32("C word9  status ", o_status, 32'h0000_032E);   // err3; magic/hdr/len ok; pay=0
+        chk32("C word10 words  ", o_words,  32'd1024);
+        chk32("C word13 runs   ", o_runs,   32'd3);
+
+        // ---------- D) busy 重入：长帧期间发布被丢弃 ----------
+        $display("=== D) busy 重入（长帧 16384B 期间再发布 → 丢弃，不重启）===");
+        publish(32'h0010_4000, 32'd16384);
+        gi = 0;
+        while (!(u_dut.u_chk.busy === 1'b1) && gi < 200000) begin
+            @(posedge clk_dhi); gi = gi + 1;
+        end
+        if (gi >= 200000) begin $display("ERROR: busy 未在预期内拉起"); errors = errors + 1; end
+        repeat (50) @(posedge clk_dhi);
+        publish(32'h0010_3000, 32'd4096);      // busy 中发布：应被丢弃
+        wait_runs(4);
+        chk32("D word9  status ", o_status, 32'h0000_003E);   // 仍是长帧结果
+        chk32("D word10 words  ", o_words,  32'd4096);
+        chk32("D word13 runs   ", o_runs,   32'd4);
+        publish(32'h0010_A000, 32'd4096);      // 完成后再发布：正常校验
+        wait_runs(5);
+        chk32("D2 word9 status ", o_status, 32'h0000_003E);
+        chk32("D2 word13 runs  ", o_runs,   32'd5);
+
+        // ---------- E) 读仲裁：pusher 桩连续请求 + checker 并发 ----------
+        $display("=== E) 读仲裁（pusher 桩连续 64 次读 + checker 并发）===");
+        push_run = 1;
+        publish(32'h0010_A000, 32'd4096);
+        
+        gi = 0;
+        while ((push_ok + push_bad < NPUSH) && gi < 400000) begin
+            @(posedge clk_dhi); gi = gi + 1;
+        end
+        if (gi >= 400000) begin $display("ERROR: pusher 桩未完成"); errors = errors + 1; end
+        chk32("E pusher ok      ", push_ok,  NPUSH);
+        chk32("E pusher bad     ", push_bad, 32'd0);
+        chk32("E word9  status  ", o_status, 32'h0000_003E);
+        chk32("E word13 runs    ", o_runs,   32'd6);
+        if (chk_ars < 1 || push_ars < 1) begin
+            $display("ERROR: AR 计数异常 chk_ars=%0d push_ars=%0d", chk_ars, push_ars);
+            errors = errors + 1;
+        end else begin
+            $display("ok: AR 计数 chk_ars=%0d push_ars=%0d", chk_ars, push_ars);
+        end
+        push_run = 0;
+
+        // ---------- F) 字库（新字 + 既有字不变 + DBG-off） ----------
+        $display("=== F) dbg 字库 word9..15 / 既有字不变 / DBG-off ===");
+        chk_a9  = 32'h0000_003E; chk_a10 = 32'h0000_0400; chk_a11 = 32'h1234_5678;
+        chk_a12 = 32'h89AB_CDEF; chk_a13 = 32'h0000_0007; chk_a14 = 32'hCAFE_0001;
+        chk_a15 = 32'hCAFE_0002;
+        #2;
+        chk32("F w9  mirror ", u_dbg.dbg_bank_word9,  chk_a9);
+        chk32("F w10 mirror ", u_dbg.dbg_bank_word10, chk_a10);
+        chk32("F w11 mirror ", u_dbg.dbg_bank_word11, chk_a11);
+        chk32("F w12 mirror ", u_dbg.dbg_bank_word12, chk_a12);
+        chk32("F w13 mirror ", u_dbg.dbg_bank_word13, chk_a13);
+        chk32("F w14 mirror ", u_dbg.dbg_bank_word14, chk_a14);
+        chk32("F w15 mirror ", u_dbg.dbg_bank_word15, chk_a15);
+        chk32("F old w0 MAGIC", u_dbg.dbg_bank_word0, 32'h5043_4946);
+        chk32("F old w3 seq ", u_dbg.dbg_bank_word3,  32'h0000_0007);
+        chk32("F old w4 base", u_dbg.dbg_bank_word4,  32'h0010_0000);
+        chk32("F old w5 len ", u_dbg.dbg_bank_word5,  32'h0027_9000);
+        chk32("F old w6 csi ", u_dbg.dbg_bank_word6,  32'hA1B2_C3D4);
+        chk32("F prod w9 dead", u_prod.dbg_bank_word9,  32'hDEAD_BEEF);
+        chk32("F prod w15 dead", u_prod.dbg_bank_word15, 32'hDEAD_BEEF);
+        // 既有 9 字 mark 快照不变（抽验 w0/w3）
+        dbg_por_rst = 1'b0;
+        repeat (4) @(posedge clk_tl);
+        chk32("F mark w0    ", u_dbg.g_dbg_mark.dbg_mark_word0, 32'h5043_4946);
+        chk32("F mark w9    ", u_dbg.g_dbg_mark.dbg_mark_word9, chk_a9);
+        chk32("F mark w15   ", u_dbg.g_dbg_mark.dbg_mark_word15, chk_a15);
+
+        if (errors == 0) $display("*** ALL PASS ***");
+        else             $display("*** FAIL: %0d errors ***", errors);
+        $display("tb_ddr_readback_int done");
+        $finish;
+    end
+
+
+    initial begin
+        #2_000_000;
+        $display("ERROR: watchdog timeout");
+        $display("*** FAIL: watchdog ***");
+        $finish;
+    end
+
+endmodule
