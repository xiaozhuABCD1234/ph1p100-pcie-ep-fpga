+    inout      wire                      cam_a_sda                               ,
+    output     wire                      cam_b_mclk                              ,
+    output     wire                      cam_b_xclr_n                            ,
+    output     wire                      cam_b_scl                               ,
+    inout      wire                      cam_b_sda                               ,
