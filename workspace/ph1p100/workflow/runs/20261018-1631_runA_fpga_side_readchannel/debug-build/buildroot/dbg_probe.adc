# T11.runB-debug-build: ChipWatcher probe marking (debug-only attribute; no functional logic change).
# Marks the frozen A-group debug bank bus (288 bit, tl_clk_user, read-only mirror) implemented in
# rtl/ep_side/img/ep_bar_win.v. TD infers the driver clock; constant words stay constant bits.
if {[catch {
  set t11_dbg_nets [get_nets -quiet {u_top/u_pcie_ep_engine/u_ep_bar_win/dbg_bank}]
  if {[llength $t11_dbg_nets] == 0} {
    set t11_dbg_nets [get_nets -quiet {ph1p_pcie_ep_top_dbg/u_top/u_pcie_ep_engine/u_ep_bar_win/dbg_bank}]
  }
  if {[llength $t11_dbg_nets] > 0} {
    set_property mark_debug "true" $t11_dbg_nets
    puts "T11_DBG_MARK_OK: [llength $t11_dbg_nets] net(s) dbg_bank marked"
  } else {
    puts "T11_DBG_MARK_MISS: dbg_bank not found"
  }
} t11_dbg_err]} { puts "T11_DBG_MARK_ERROR: $t11_dbg_err" }
