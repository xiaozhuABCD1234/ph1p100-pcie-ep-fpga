
 
 #100MHz
 set_pin_assignment { sys_clk    } { LOCATION = H4  ; IOSTANDARD = SSTL135; }
# SW7
 set_pin_assignment { sys_rst_n  } { LOCATION = R14 ; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP;}

# UART#0
set_pin_assignment { usr_uart_txd } { LOCATION = R17; IOSTANDARD = LVCMOS33;PULLTYPE = PULLUP;}
set_pin_assignment { usr_uart_rxd } { LOCATION = P16; IOSTANDARD = LVCMOS33;PULLTYPE = PULLUP;}

#LED1 -->D37
 set_pin_assignment { led[0]    } { LOCATION = E21 ; IOSTANDARD = LVCMOS33;}
#LED2 -->D38
 set_pin_assignment { led[1]    } { LOCATION = D21 ; IOSTANDARD = LVCMOS33;}
#LED3 -->D39
 set_pin_assignment { led[2]    } { LOCATION = E22 ; IOSTANDARD = LVCMOS33;}

