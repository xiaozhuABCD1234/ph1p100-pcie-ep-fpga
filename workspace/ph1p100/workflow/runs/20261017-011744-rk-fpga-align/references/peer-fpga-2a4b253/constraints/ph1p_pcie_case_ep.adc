# ================= 摄像头子卡 FEP-VID006-MIPI（IMX415 x2）=================
# 以下管脚逐字抄自参考工程 uisrc/04_pin/fep_vid006_imx415.adc
# cam_a_xclr_n 占用原串口 rxd 的 P16，本工程不再引出串口接收。
set_pin_assignment { mipi_a_clk_hs_p          } { LOCATION = K18; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_a_clk_hs_n          } { LOCATION = K19; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_a_data_hs_p[0]      } { LOCATION = N20; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_a_data_hs_n[0]      } { LOCATION = M20; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_a_data_hs_p[1]      } { LOCATION = K21; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_a_data_hs_n[1]      } { LOCATION = K22; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_a_data_hs_p[2]      } { LOCATION = N18; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_a_data_hs_n[2]      } { LOCATION = N19; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_a_data_hs_p[3]      } { LOCATION = M21; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_a_data_hs_n[3]      } { LOCATION = L21; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_b_clk_hs_p          } { LOCATION = J19; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_b_clk_hs_n          } { LOCATION = H19; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_b_data_hs_p[0]      } { LOCATION = J22; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_b_data_hs_n[0]      } { LOCATION = H22; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_b_data_hs_p[1]      } { LOCATION = G17; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_b_data_hs_n[1]      } { LOCATION = G18; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_b_data_hs_p[2]      } { LOCATION = J20; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_b_data_hs_n[2]      } { LOCATION = J21; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_b_data_hs_p[3]      } { LOCATION = L19; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { mipi_b_data_hs_n[3]      } { LOCATION = L20; IOSTANDARD = LVDS18; PULLTYPE = NONE;; }
set_pin_assignment { cam_a_xclr_n             } { LOCATION = M18; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8;; }
set_pin_assignment { cam_a_mclk               } { LOCATION = L18; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8;; }
set_pin_assignment { cam_a_scl                } { LOCATION = N22; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; DRIVESTRENGTH = 8;; }
set_pin_assignment { cam_a_sda                } { LOCATION = M22; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; DRIVESTRENGTH = 8;; }
set_pin_assignment { cam_b_scl                } { LOCATION = H13; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; DRIVESTRENGTH = 8;; }
set_pin_assignment { cam_b_sda                } { LOCATION = G13; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; DRIVESTRENGTH = 8;; }
set_pin_assignment { cam_b_xclr_n             } { LOCATION = H20; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8;; }
set_pin_assignment { cam_b_mclk               } { LOCATION = G20; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8;; }
