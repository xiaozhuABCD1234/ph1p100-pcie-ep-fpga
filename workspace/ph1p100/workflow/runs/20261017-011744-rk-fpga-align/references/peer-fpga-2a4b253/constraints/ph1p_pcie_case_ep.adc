#AP119_v2.0 demo board
set_pin_assignment		{ sys_clk  	   }		    { LOCATION = H4;  IOSTANDARD = SSTL135;	 }
set_pin_assignment		{ pcie_power_on_rst }		{ LOCATION = R14; IOSTANDARD = LVCMOS33; }
set_pin_assignment		{ user_int_trigger }	    { LOCATION = P14; IOSTANDARD = LVCMOS33; }
set_pin_assignment	    { pcie_mperst  }		    { LOCATION = P15; IOSTANDARD = LVCMOS33; }
set_pin_assignment		{ txd }				    	{ LOCATION = R17; IOSTANDARD = LVCMOS33; }
set_pin_assignment		{ debug_led[0] }		    { LOCATION = E21; IOSTANDARD = LVCMOS33; }
set_pin_assignment		{ debug_led[1] }		    { LOCATION = D21; IOSTANDARD = LVCMOS33; }
set_pin_assignment		{ debug_led[2] }		    { LOCATION = E22; IOSTANDARD = LVCMOS33; }
set_pin_assignment		{ debug_led[3] }		    { LOCATION = D22; IOSTANDARD = LVCMOS33; }
