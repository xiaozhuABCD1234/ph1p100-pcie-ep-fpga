  "diffs": {
    "p1_to_p3_tb": [
      "--- tb_ss_anchor.v",
      "+++ tb_ss_g0.v",
      "@@ -1,24 +1,32 @@",
      " `timescale 1ns/1ps",
      " // =============================================================================",
      "-// tb_ss_anchor.v -- derived ONLY from the frozen b11 reference TB",
      "-// (src/ref/tb_b11_full.v, sha256 e278cea5...ac699).  DUT sources are unchanged.",
      "+// tb_ss_g0.v -- P3 G0-closure TB, derived ONLY from the frozen P1 TB",
      "+// src/ref/tb_ss_anchor.v (sha256 ddd9e02c...1ff).  All 12 DUT/model sources are",
      "+// byte-identical to the P1/b11 frozen copies; no DUT line is modified.",
      " //",
      "-// Allowed differences (fpga-design-guide.md 3.2 whitelist):",
      "-//   1  parameter FRAMES (default 4; control run uses 2); st_exp drain / final",
      "-//      gate use FRAMES.  The inherited informational \"2*129600\" READ_DONE",
      "-//      wait is intentionally left byte-identical to b11 (see DIFF.md).",
      "-//   2  SS_EVT event prints (read-only taps of the top-level st_* outputs).",
      "-//   3  slot-free pacing for frames 3/4 (waits until the target RAW slot is",
      "-//      FREE via the read-only st_slot_st observation).",
      "-//   4  per-frame watchdog: no st_exp increment for 8,000,000 cycles ->",
      "-//      SS_STALL + $finish (pass=0).",
      "-//   5  MAX_CYCLES = 30,000,000.",
      "-//   6  path registers widened to [4095:0].",
      "-//   7  stats line keeps the b11 field order and appends frames=/ss_pass=.",
      "-//   8  DEC/STAT/EVT absolute paths via +plusargs (sim/caps/).",
      "-// Extra TB-only markers: SS_META, SS_PACE, SS_STATS (documented in DIFF.md).",
      "+// Allowed differences vs P1 tb_ss_anchor.v (see src/DIFF.md):",
      "+//   A  parameters CONTENT/PACING/SINK/CAPTURE + MAX_CYCLES=48,000,000",
      "+//   B  CONTENT 0 = P1 smooth smp gradient; CONTENT 1 = comp-vector proxy",
      "+//      (raw image precomputed by sim/prep_content.py as the exact inverse of",
      "+//      the frozen A1 PREP/PRED transform of the tiled comp xform vector, so the",
      "+//      DUT re-applies the transform and the core consumes the vector exactly)",
      "+//   C  PACING 0 = P1 slot-free (overlapped); PACING 1 = strict-serial",
      "+//      (frame k>=2 starts only after st_exported >= k-1, then slot free)",
      "+//   D  SINK 0 = P1 clk_uart=clk_a1 (18.75 MB/s sim sink); SINK 1 = 2 GHz",
      "+//      clk_uart (200 MB/s request; the a1-domain handoff caps it near",
      "+//      1 byte/clk_a1 = 187.5 MB/s, reported from measurement)",
      "+//   E  CAPTURE 1 = P1 per-byte .dec; CAPTURE 0 = no per-byte .dec, only the",
      "+//      first 256 exported bytes (<=1 frame header) + byte count",
      "+//   F  byte-level xform self check (frame 1 only): rebuild each 5-byte",
      "+//      transform-domain group from the driven tap_pix with the frozen",
      "+//      PREP/PRED formula and compare against the vector; SS_VEC_MATCH bad=0",
      "+//   G  stats line keeps the P1 16 fields in order, then frames/ss_pass and the",
      "+//      P3 mode fields; SS_META extends the P1 fields with content/pacing/sink",
      "+//   H  watchdog window 12,000,000 cycles (strict-serial comp frame can exceed",
      "+//      the P1 8,000,000 window); still far below MAX_CYCLES",
      "+// Event/SS_EVT/SS_PACE/SS_STATS protocol is unchanged from P1.",
      " // =============================================================================",
      "-module tb_ss_anchor #(",
      "+module tb_ss_g0 #(",
      "     parameter integer CAM_W = 3864,",
      "     parameter integer CAM_H = 2192,",
      "     parameter integer ROI_X = 972,",
      "@@ -29,16 +37,27 @@",
      "     parameter integer LINE_GAP = 16,",
      "     parameter integer FRAME_GAP = 400,",
      "     parameter integer FRAMES = 4,",
      "-    parameter integer MAX_CYCLES = 30000000",
      "+    parameter integer MAX_CYCLES = 48000000,",
      "+    parameter integer CONTENT = 0,",
      "+    parameter integer PACING  = 0,",
      "+    parameter integer SINK    = 0,",
      "+    parameter integer CAPTURE = 1",
      " ) ();",
      "     localparam integer CG = CAM_W / 4;",
      "+    localparam integer OG = W / 4;",
      "+    localparam integer GX = ROI_X / 4;",
      "     localparam integer RAW_WORDS = 129600;",
      "-    localparam integer WD_LIMIT = 8000000;",
      "+    localparam integer WD_LIMIT = 12000000;",
      " ",
      "     reg clk_cam = 1'b0, clk_a1 = 1'b0, clk_ddr = 1'b0, rst_n = 1'b0;",
      "     always #2.6665 clk_cam = ~clk_cam;",
      "     initial begin #1.7000; forever #2.6665 clk_a1 = ~clk_a1; end",
      "     initial begin #0.4000; forever #2.5000 clk_ddr = ~clk_ddr; end",
      "+",
      "+    // SINK=1: 2 GHz UART clock (period 0.5 ns).  SINK=0 keeps the P1 net.",
      "+    reg clk_uart_f = 1'b0;",
      "+    always #0.25 clk_uart_f = ~clk_uart_f;",
      "+    wire clk_uart = (SINK != 0) ? clk_uart_f : clk_a1;",
      " ",
      "     reg  [39:0] tap_pix = 40'd0;",
      "     reg         tap_v = 1'b0, tap_line = 1'b0, tap_frame = 1'b0, tap_vs = 1'b0;",
      "@@ -65,7 +84,7 @@",
      "         .CAM_W (CAM_W), .CAM_H (CAM_H), .ROI_X (ROI_X), .ROI_Y (ROI_Y),",
      "         .W (W), .H (H), .UART_DIV (UART_DIV), .STS_DIV (0)",
      "     ) dut (",
      "-        .clk_cam (clk_cam), .clk_a1 (clk_a1), .clk_uart (clk_a1), .rst_n (rst_n),",
      "+        .clk_cam (clk_cam), .clk_a1 (clk_a1), .clk_uart (clk_uart), .rst_n (rst_n),",
      "         .i_a_pixel (tap_pix), .i_a_pixel_valid (tap_v),",
      "         .i_a_in_line (tap_line), .i_a_in_frame (tap_frame), .i_a_vsync (tap_vs),",
      "         .i_ddr_rdy (1'b1),",
      "@@ -109,10 +128,13 @@",
      "     );",
      " ",
      "     // ------------------------------------------------------------ capture",
      "-    integer fd, fs, fe, cap_bytes = 0, cycles = 0;",
      "+    integer fd, fs, fe, fh, cap_bytes = 0, cycles = 0;",
      "     reg [4095:0] stat_path = 4096'd0;",
      "     reg [4095:0] dec_path  = 4096'd0;",
      "     reg [4095:0] evt_path  = 4096'd0;",
      "+    reg [4095:0] hdr_path  = 4096'd0;",
      "+    reg [4095:0] raw_path  = 4096'd0;",
      "+    reg [4095:0] vec_path  = 4096'd0;",
      "     integer t_rst = 0;",
      "     integer t_sof [0:7];",
      "     integer t_cam_end [0:7];",
      "@@ -121,17 +143,27 @@",
      "     integer last_exp_t = 0;",
      "     integer evt_i;",
      " ",
      "-    // Final gate: b11 fields plus raw/cmp drops and cap; appended to stats.",
      "+    // comp proxy memories (+RAW/+VEC hex files, 40-bit groups)",
      "+    reg [39:0] raw_mem [0:518399];",
      "+    reg [39:0] vec_mem [0:30719];",
      "+    integer drv_groups = 0, vec_bad = 0, vec_checked = 0;",
      "+    reg [9:0]  vprev0 = 10'd0, vprev1 = 10'd0, vprev2 = 10'd0, vprev3 = 10'd0;",
      "+    reg [39:0] vacc0 = 40'd0, vacc1 = 40'd0, vacc2 = 40'd0, vacc3 = 40'd0;",
      "+    reg [1:0]  vn0 = 2'd0, vn1 = 2'd0, vn2 = 2'd0, vn3 = 2'd0;",
      "+    integer    vq0 = 0, vq1 = 0, vq2 = 0, vq3 = 0;",
      "+    integer    vbase = 0;",
      "+    reg [39:0] vchk_w;",
      "+    integer    pk;",
      "+    reg [9:0]  ps, pd;",
      "+    reg [39:0] cur;",
      "+",
      "+    // Final gate: P1 fields plus raw/cmp drops and cap; appended to stats.",
      "     wire ss_pass = (st_cap == FRAMES) && (st_exp == FRAMES) && (st_enc == FRAMES) &&",
      "                    (st_read == FRAMES*RAW_WORDS) && (st_dup == 0) && (st_err == 0) &&",
      "                    (st_pub == FRAMES) && (st_geom == 0) && (st_rdrop == 0) &&",
      "                    (st_cdrop == 0) && (dut.wd_fires == 0);",
      " ",
      "     always @(posedge clk_a1) begin",
      "-        if (rst_n && dbg_byte_valid) begin",
      "-            $fwrite(fd, \"%0d\\n\", dbg_byte);",
      "-            cap_bytes = cap_bytes + 1;",
