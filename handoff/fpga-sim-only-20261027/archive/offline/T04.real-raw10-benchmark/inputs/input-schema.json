{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T04 RAW10 software benchmark input v1",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "type": "object",
      "required": [
        "prep",
        "pred"
      ],
      "properties": {
        "prep": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "pred": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      }
    },
    "samples": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "required": [
        "sample_id",
        "category",
        "path",
        "sha256",
        "format",
        "width",
        "height",
        "stride",
        "roi",
        "bayer_phase",
        "normalized_raw_sha256",
        "provenance",
        "content_id"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "category": {
          "enum": [
            "sensor_capture",
            "synthetic_control",
            "historical_control"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "format": {
          "enum": [
            "packed_raw10",
            "u16"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1920,
          "multipleOf": 4
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 65535
        },
        "stride": {
          "type": "integer",
          "minimum": 5
        },
        "bayer_phase": {
          "enum": [
            "unknown",
            "RGGB",
            "GRBG",
            "GBRG",
            "BGGR"
          ]
        },
        "phase_evidence": {
          "type": "string",
          "minLength": 1
        },
        "normalized_raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "content_id": {
          "type": "string",
          "minLength": 1
        },
        "normalization": {
          "type": "object",
          "required": [
            "byte_order",
            "valid_bits",
            "right_shift"
          ],
          "properties": {
            "byte_order": {
              "enum": [
                "little",
                "big"
              ]
            },
            "valid_bits": {
              "const": 10
            },
            "right_shift": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          }
        },
        "roi": {
          "type": "object",
          "required": [
            "x",
            "y",
            "width",
            "height",
            "source_width",
            "source_height"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "minimum": 0
            },
            "source_width": {
              "type": "integer",
              "minimum": 0
            },
            "source_height": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "source_kind",
            "source",
            "device",
            "captured_at",
            "license_basis",
            "format_basis",
            "sensor_pixel_oracle_verified"
          ],
          "properties": {
            "source_kind": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "type": "string",
              "minLength": 1
            },
            "license_basis": {
              "type": "string",
              "minLength": 1
            },
            "format_basis": {
              "type": "string",
              "minLength": 1
            },
            "sensor_pixel_oracle_verified": {
              "type": "boolean"
            },
            "pixel_oracle": {
              "type": "object",
              "required": [
                "method",
                "reviewer",
                "correctness_basis",
                "evidence_path",
                "evidence_sha256",
                "normalized_raw_sha256",
                "review_decision"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "correctness_basis": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_path": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "normalized_raw_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "review_decision": {
                  "const": "qualified"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "u16"
              }
            }
          },
          "then": {
            "required": [
              "normalization"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "sensor_capture"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "required": [
                  "pixel_oracle"
                ],
                "properties": {
                  "source_kind": {
                    "const": "sensor_capture"
                  },
                  "sensor_pixel_oracle_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
